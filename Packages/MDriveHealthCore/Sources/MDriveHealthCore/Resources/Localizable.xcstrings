{
  "sourceLanguage": "vi",
  "strings": {
    "issue.nvme.readonly.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Media đã chuyển sang chế độ chỉ đọc"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media in read-only mode"
          }
        }
      }
    },
    "issue.nvme.readonly.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller đã khoá media ở chế độ chỉ đọc. Hãy sao lưu ngay lập tức và thay ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The controller has locked the media read-only. Back up immediately and replace the drive."
          }
        }
      }
    },
    "issue.nvme.reliability.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ tin cậy NVM suy giảm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NVM subsystem reliability degraded"
          }
        }
      }
    },
    "issue.nvme.reliability.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller báo độ tin cậy suy giảm do lỗi media hoặc lỗi nội bộ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The controller reports degraded reliability due to media or internal errors."
          }
        }
      }
    },
    "issue.nvme.spare.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare dự phòng dưới ngưỡng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available spare below threshold"
          }
        }
      }
    },
    "issue.nvme.spare.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khối dự phòng còn %lld%%, thấp hơn ngưỡng %lld%%. Ổ sắp cạn vùng dự phòng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spare blocks at %lld%% are below the %lld%% threshold. The drive is running out of reserve capacity."
          }
        }
      }
    },
    "issue.nvme.tempbit.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ ngoài ngưỡng cho phép"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature outside thresholds"
          }
        }
      }
    },
    "issue.nvme.tempbit.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller báo đang hoạt động ngoài ngưỡng nhiệt an toàn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The controller reports operation outside its temperature thresholds."
          }
        }
      }
    },
    "issue.nvme.backup.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ backup nguồn cho bộ nhớ đệm bị hỏng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volatile memory backup failed"
          }
        }
      }
    },
    "issue.nvme.backup.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị dự phòng mất điện cho volatile memory đã hỏng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The power-loss protection backup device has failed."
          }
        }
      }
    },
    "issue.nvme.pmr.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng persistent memory không ổn định"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistent memory region unreliable"
          }
        }
      }
    },
    "issue.nvme.pmr.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng persistent memory đang ở chế độ chỉ đọc hoặc không đáng tin cậy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The persistent memory region is read-only or unreliable."
          }
        }
      }
    },
    "issue.wear.exhausted.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dùng hết tuổi thọ định mức"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rated endurance exhausted"
          }
        }
      }
    },
    "issue.nvme.wear.exhausted.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức hao mòn theo nhà sản xuất là %lld%%. Ổ đã vượt tuổi thọ định mức — vẫn có thể hoạt động nhưng nên lên kế hoạch thay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendor wear estimate is %lld%%. The drive exceeded its rated endurance; it may keep working but plan a replacement."
          }
        }
      }
    },
    "issue.wear.high.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuổi thọ sắp cạn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurance nearly exhausted"
          }
        }
      }
    },
    "issue.nvme.wear.high.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức hao mòn theo nhà sản xuất là %lld%% tuổi thọ định mức."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendor wear estimate is %lld%% of rated endurance."
          }
        }
      }
    },
    "issue.nvme.mediaerrors.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi toàn vẹn dữ liệu (media errors)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media integrity errors"
          }
        }
      }
    },
    "issue.nvme.mediaerrors.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra %lld lỗi toàn vẹn dữ liệu không khôi phục được."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld unrecovered data-integrity errors have occurred."
          }
        }
      }
    },
    "issue.temp.critical.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ chạm mức nguy hiểm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature at critical level"
          }
        }
      }
    },
    "issue.nvme.temp.critical.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ tổng hợp %lld°C đã chạm ngưỡng nguy hiểm %lld°C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composite temperature %lld°C reached the critical threshold %lld°C."
          }
        }
      }
    },
    "issue.temp.high.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ vượt ngưỡng cảnh báo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature above warning threshold"
          }
        }
      }
    },
    "issue.nvme.temp.high.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ tổng hợp %lld°C vượt ngưỡng cảnh báo %lld°C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composite temperature %lld°C exceeds the warning threshold %lld°C."
          }
        }
      }
    },
    "issue.ata.status.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART tổng thể: ĐANG HỎNG"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART overall status: FAILING"
          }
        }
      }
    },
    "issue.ata.status.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính ổ đĩa dự báo sắp hỏng (đã vượt ngưỡng nhà sản xuất). Sao lưu dữ liệu ngay lập tức."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive itself predicts failure (vendor thresholds exceeded). Back up your data immediately."
          }
        }
      }
    },
    "issue.ata.tripped.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dưới ngưỡng hỏng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ below failure threshold"
          }
        }
      }
    },
    "issue.ata.tripped.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuộc tính pre-fail %lld (%@) có giá trị %lld, đã chạm/dưới ngưỡng %lld. Ổ được dự báo sắp hỏng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-fail attribute %lld (%@) value %lld is at or below threshold %lld. Failure is predicted."
          }
        }
      }
    },
    "issue.ata.trippedpast.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ từng chạm ngưỡng hỏng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed in the past"
          }
        }
      }
    },
    "issue.ata.trippedpast.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuộc tính pre-fail %lld (%@) từng tụt xuống %lld, chạm/dưới ngưỡng %lld trong quá khứ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-fail attribute %lld (%@) dropped to %lld, at or below threshold %lld, at some point in the past."
          }
        }
      }
    },
    "issue.ata.5.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có sector đã cấp phát lại"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reallocated sectors present"
          }
        }
      }
    },
    "issue.ata.196.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có sự kiện cấp phát lại sector"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reallocation events recorded"
          }
        }
      }
    },
    "issue.ata.realloc.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đếm được %lld. Defect tăng dần là dấu hiệu bề mặt lưu trữ xuống cấp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ raw count is %lld. Growing defects indicate media degradation."
          }
        }
      }
    },
    "issue.ata.197.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sector không ổn định (pending)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending (unstable) sectors"
          }
        }
      }
    },
    "issue.ata.197.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sector đang chờ được cấp phát lại. Dữ liệu trong đó có thể không đọc được."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sectors are waiting to be remapped. Data in them may be unreadable."
          }
        }
      }
    },
    "issue.ata.198.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sector không sửa được"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncorrectable sectors"
          }
        }
      }
    },
    "issue.ata.198.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sector không thể đọc/sửa trong các lần quét offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sectors could not be read or corrected during offline scans."
          }
        }
      }
    },
    "issue.ata.187.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi không khôi phục được (reported)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported uncorrectable errors"
          }
        }
      }
    },
    "issue.ata.187.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lỗi ECC không khôi phục được đã được ghi nhận."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld errors could not be recovered by ECC."
          }
        }
      }
    },
    "issue.ata.10.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trục quay phải thử lại"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spin-up retries"
          }
        }
      }
    },
    "issue.ata.10.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trục quay cần %lld lần thử để đạt tốc độ — có thể do vấn đề cơ khí hoặc nguồn điện."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spindle needed %lld retries to reach speed — a possible mechanical or power issue."
          }
        }
      }
    },
    "issue.ata.184.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi End-to-End"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-End errors"
          }
        }
      }
    },
    "issue.ata.184.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lỗi parity trên đường dữ liệu giữa cache và media."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld data-path parity errors between cache and media."
          }
        }
      }
    },
    "issue.ata.188.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh bị quá thời gian (timeout)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command timeouts"
          }
        }
      }
    },
    "issue.ata.188.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lệnh bị timeout — có thể do cáp hoặc controller có vấn đề."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commands timed out — possibly cabling or controller trouble."
          }
        }
      }
    },
    "issue.ata.199.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi CRC giao tiếp"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface CRC errors"
          }
        }
      }
    },
    "issue.ata.199.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lỗi CRC trên đường SATA — thường do cáp/đầu nối, không phải bản thân ổ đĩa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld CRC errors on the SATA link — usually a cable/connector problem, not the drive itself."
          }
        }
      }
    },
    "issue.ata.wear.exhausted.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số hao mòn của SSD báo đã hết tuổi thọ định mức."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSD wear indicator reports no rated endurance left."
          }
        }
      }
    },
    "issue.ata.wear.high.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn khoảng %lld%% tuổi thọ định mức."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %lld%% of rated endurance remains."
          }
        }
      }
    },
    "issue.ata.temp.detail": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt độ ổ đĩa là %lld°C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive temperature is %lld°C."
          }
        }
      }
    },
    "issue.ata.drivedb.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ổ này có vấn đề đã biết"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known issue for this drive model"
          }
        }
      }
    },
    "benchmark.error.config": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình benchmark không hợp lệ: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid benchmark configuration: %@"
          }
        }
      }
    },
    "benchmark.error.readonly": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ghi được lên volume %@ (chỉ đọc?)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot write to volume %@ (read-only?)."
          }
        }
      }
    },
    "benchmark.error.space": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ dung lượng trống: cần %1$lld byte, còn %2$lld byte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free space: need %1$lld bytes, have %2$lld bytes."
          }
        }
      }
    },
    "benchmark.error.filesize": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng ổ này giới hạn file tối đa %lld byte — hãy chọn cỡ nhỏ hơn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This filesystem caps file size at %lld bytes — choose a smaller size."
          }
        }
      }
    },
    "benchmark.error.create": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tạo được file kiểm tra tại %1$@ (errno %2$lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create the test file at %1$@ (errno %2$lld)."
          }
        }
      }
    },
    "benchmark.error.io": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi %1$@ khi đo (errno %2$lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ failed during the benchmark (errno %2$lld)."
          }
        }
      }
    },
    "benchmark.error.short": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc/ghi thiếu: mong %1$lld byte, được %2$lld byte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short I/O: expected %1$lld bytes, got %2$lld bytes."
          }
        }
      }
    },
    "benchmark.error.cancelled": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã huỷ benchmark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Benchmark cancelled."
          }
        }
      }
    },
    "benchmark.error.running": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có một benchmark khác chạy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another benchmark is already running."
          }
        }
      }
    },
    "benchmark.error.diskFull": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume bị đầy giữa lúc đo — hãy giải phóng thêm dung lượng rồi thử lại."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume filled up during the test — free some space and try again."
          }
        }
      }
    },
    "benchmark.error.volumeChanged": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume không còn khớp với lựa chọn ban đầu: %@. Hãy làm mới danh sách ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume no longer matches the original selection: %@. Refresh the drive list."
          }
        }
      }
    },
    "benchmark.error.cleanup": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dọn được toàn bộ file của phiên kiểm tra tại %@. File không thuộc phiên được giữ nguyên."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some test files could not be cleaned up at %@. Files not owned by the session were preserved."
          }
        }
      }
    },
    "capacity.error.boot": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kiểm tra dung lượng trên volume khởi động. Hãy chọn volume ngoài đã sao lưu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacity write tests are disabled on the startup volume. Select a backed-up external volume."
          }
        }
      }
    },
    "capacity.error.consent": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần xác nhận đã sao lưu và hiểu rủi ro ghi thử; APFS dùng chung dung lượng cần xác nhận riêng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that data is backed up and that you understand the write-test risk. Shared APFS capacity needs separate confirmation."
          }
        }
      }
    },
    "capacity.result.passed.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PHẦN ĐÃ KIỂM TRA KHỚP DỮ LIỆU"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TESTED DATA MATCHES"
          }
        }
      }
    },
    "capacity.result.corrupt.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PHÁT HIỆN DỮ LIỆU KIỂM TRA BỊ HỎNG"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TEST DATA CORRUPTION DETECTED"
          }
        }
      }
    },
    "capacity.result.inconclusive.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CHƯA KẾT LUẬN ĐƯỢC"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "INCONCLUSIVE"
          }
        }
      }
    },
    "capacity.result.scope": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ghi %1$@, xác minh khớp %2$@, yêu cầu %3$@. Kết quả chỉ áp dụng cho dữ liệu đã kiểm tra, không chứng nhận toàn bộ dung lượng ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrote %1$@, verified matching %2$@, requested %3$@. This result covers only tested data and does not certify the entire drive capacity."
          }
        }
      }
    },
    "capacity.result.corrupt.reason": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có dữ liệu đọc lại khác dữ liệu đã ghi. Nguyên nhân có thể là media, kết nối hoặc firmware khai khống; chưa xác định được dung lượng vật lý thật. Không dùng ổ này cho dữ liệu quan trọng trước khi kiểm tra thêm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some data read back differs from what was written. Possible causes include media, connection or fraudulent firmware; physical capacity has not been determined. Investigate before trusting important data to this drive."
          }
        }
      }
    },
    "capacity.result.incomplete.reason": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên kiểm tra chưa hoàn tất tin cậy do lỗi đọc/ghi, hết chỗ trống hoặc không xác nhận được cache/flush."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested test did not complete reliably because of I/O, free-space or cache/flush verification problems."
          }
        }
      }
    },
    "health.coverage.complete": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá từ các chỉ số SMART được hỗ trợ; không bảo đảm ổ sẽ không hỏng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessment uses supported SMART indicators; it cannot guarantee against drive failure."
          }
        }
      }
    },
    "health.coverage.partial": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART thiếu dữ liệu hoặc chưa có mapping đáng tin cậy cho model này. Chỉ hiển thị các vấn đề đã xác định; chưa chấm điểm sức khỏe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART data is incomplete or this model lacks a reliable mapping. Known issues are shown; a health score is unavailable."
          }
        }
      }
    },
    "health.coverage.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có dữ liệu SMART hợp lệ để đánh giá sức khỏe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid SMART data is available to assess health."
          }
        }
      }
    },
    "rating.unknown": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác định"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "health.noKnownIssues": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phát hiện vấn đề trong các chỉ số được hỗ trợ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No issues found in the supported indicators."
          }
        }
      }
    },
    "health.notEnoughData": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đủ dữ liệu để kết luận sức khỏe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insufficient data to assess health."
          }
        }
      }
    },
    "risk.unknown.title": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác định sức khỏe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health is unknown"
          }
        }
      }
    },
    "risk.unknown.message": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số SMART hiện có chưa đủ để đánh giá. Duy trì sao lưu và kiểm tra các chỉ báo đã xác định."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available SMART indicators are insufficient for assessment. Keep backups and review any known issues."
          }
        }
      }
    },
    "Chưa xác định": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác định"
          }
        },
        "en": {
