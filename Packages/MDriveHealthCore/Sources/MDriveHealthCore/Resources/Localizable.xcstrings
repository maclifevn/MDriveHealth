            "value": "Unknown"
          }
        }
      }
    },
    "issue.nvme.mediaerrors.large": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ báo số lỗi media rất lớn; chưa hỗ trợ hiển thị chính xác bộ đếm này. Hãy sao lưu và kiểm tra ổ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive reports an extremely large media error count that cannot be displayed exactly. Back up your data and check the drive."
          }
        }
      }
    },
