    "Benchmark cần một volume đã mount và ghi được. Ổ chưa định dạng hoặc chưa mount thì không đo được.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Benchmark cần một volume đã mount và ghi được. Ổ chưa định dạng hoặc chưa mount thì không đo được."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The benchmark needs a mounted, writable volume. Unformatted or unmounted drives can't be tested."
          }
        }
      }
    },
