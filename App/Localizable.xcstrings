    "selftest.execution.help": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-test do firmware ổ đĩa thực hiện. Thời gian chạy và ảnh hưởng đến tốc độ phụ thuộc thiết bị và tải I/O. Kết quả không thay thế việc sao lưu dữ liệu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-tests are performed by the drive firmware. Duration and impact on throughput depend on the device and I/O load. Results do not replace data backups."
          }
        }
      }
    },
    "selftest.extended": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Test mở rộng"
