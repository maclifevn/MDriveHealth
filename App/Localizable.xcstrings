    "Dữ liệu từ phiên bản cũ được giữ riêng trong database vì cách định danh và diễn giải chỉ số đã thay đổi; không dùng cho biểu đồ hoặc cảnh báo mới.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu từ phiên bản cũ được giữ riêng trong database vì cách định danh và diễn giải chỉ số đã thay đổi; không dùng cho biểu đồ hoặc cảnh báo mới."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data from older versions is kept separately in the database because drive identification and metric interpretation have changed. It is excluded from new charts and alerts."
          }
        }
      }
    },
    "Dữ liệu đã ghi": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu đã ghi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data written"
          }
        }
      }
    },
    "Dữ liệu đã được sao lưu hoặc volume trống có thể xóa bỏ; tôi hiểu rủi ro ghi thử.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu đã được sao lưu hoặc volume trống có thể xóa bỏ; tôi hiểu rủi ro ghi thử."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is backed up, or this is an empty disposable volume. I understand the write-test risk."
          }
        }
      }
    },
