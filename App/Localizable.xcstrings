    "recovery.confirmDetail": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App kiểm tra lại volume, manifest và identity từng file trước khi xóa. Chỉ dọn workspace này; file lạ hoặc thông tin đã đổi sẽ chặn cleanup. Kích thước hiển thị là logical file bytes, không phải cam kết dung lượng giải phóng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app rechecks the volume, manifest and each file identity before deleting. Only this workspace is cleaned up; unknown files or changed information block cleanup. The displayed size is logical file bytes, not guaranteed freed space."
          }
        }
      }
    },
    "recovery.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
