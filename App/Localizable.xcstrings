    "Chưa định danh chắc chắn: lịch sử chỉ gắn với ổ trong phiên này, không tự nối qua lần khởi động hoặc cắm lại.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa định danh chắc chắn: lịch sử chỉ gắn với ổ trong phiên này, không tự nối qua lần khởi động hoặc cắm lại."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive identity is uncertain: history is linked only within this session and does not automatically continue after restart or reconnection."
          }
        }
      }
    },
