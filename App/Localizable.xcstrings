    "risk.unsupported.action.io": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi lỗi I/O trong kernel log nếu ổ hay ngắt kết nối."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch kernel I/O errors if the drive disconnects often."
          }
        }
      }
    },
    "risk.unsupported.action.passthrough": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử cáp hoặc hộp ổ khác có SMART passthrough."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another cable or enclosure with SMART passthrough."
          }
        }
      }
    },
    "risk.unsupported.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART chưa khả dụng qua giao diện hiện tại của ổ này. Hỗ trợ phụ thuộc thiết bị, bridge và driver; đổi kết nối không bảo đảm sẽ đọc được. Thiếu dữ liệu SMART không tự chứng minh ổ bị lỗi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART is unavailable through this drive’s current interface. Support depends on the device, bridge and driver; changing the connection does not guarantee access. Missing SMART data does not by itself mean the drive is faulty."
          }
        }
      }
    },
    "risk.unsupported.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART không khả dụng"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART unavailable"
          }
        }
      }
    },
    "selftest.accepted": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware đã nhận lệnh lúc %@. App tiếp tục theo dõi khi tab đóng và khôi phục sau khi mở lại."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware accepted the command at %@. Tracking continues when the tab closes and resumes after app restart."
          }
