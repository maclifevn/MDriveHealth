    },
    "Chưa đọc được SMART qua cầu nối này với giao diện hiện có. Khả năng hỗ trợ phụ thuộc bridge và driver. Bạn vẫn có thể đo tốc độ và kiểm tra dữ liệu trên phần dung lượng trống ở tab Tốc độ.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đọc được SMART qua cầu nối này với giao diện hiện có. Khả năng hỗ trợ phụ thuộc bridge và driver. Bạn vẫn có thể đo tốc độ và kiểm tra dữ liệu trên phần dung lượng trống ở tab Tốc độ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART access through this bridge is unavailable with the current interface. Support depends on the bridge and driver. You can still benchmark speed or verify data in free space; back up before a write test."
          }
        }
      }
    },
