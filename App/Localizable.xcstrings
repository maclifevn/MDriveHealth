    "onboarding.health.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App đánh giá các chỉ số SMART được hỗ trợ. Khi thiếu dữ liệu hoặc mapping đáng tin cậy, sức khỏe được giữ là Chưa xác định; điểm số không dự đoán chắc chắn ổ sẽ hỏng. Luôn giữ bản sao lưu, kể cả khi ổ được đánh giá Tốt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app evaluates supported SMART metrics. Missing data or uncertain mappings leave health Unknown; a score cannot reliably predict drive failure. Keep backups even when a drive is rated Good."
          }
        }
      }
    },
    "onboarding.health.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART & sức khỏe ổ đĩa"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART & drive health"
          }
        }
      }
    },
    "onboarding.login.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký bên dưới để yêu cầu app tự mở sau khi đăng nhập. Nếu macOS chưa cho phép, app sẽ chỉ rõ trạng thái và đường dẫn cấp phép. Bạn vẫn có thể dùng app mà không đăng ký."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register below to request that the app opens after login. If macOS approval is pending, the app shows its status and where to approve it. You can use the app without registering."
          }
        }
      }
    },
    "onboarding.monitoring.body": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi nền đọc SMART theo chu kỳ và ghi nhận thay đổi. Bạn có thể tắt theo dõi hoặc đổi ngưỡng trong Settings. macOS có thể hỏi quyền thông báo; cảnh báo chỉ hiện khi được cho phép. Các kết quả tự kiểm tra đã lưu vẫn xem được trong lịch sử khi thông báo bị tắt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background monitoring polls SMART and records changes. You can disable monitoring or change thresholds in Settings. macOS may ask for notification permission; alerts appear only when allowed. Saved self-test results remain available in history when notifications are disabled."
          }
        }
      }
    },
    "operation.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device or a background operation is busy. Wait for it to finish, then retry."
