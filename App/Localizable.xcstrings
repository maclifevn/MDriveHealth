            "state": "translated",
            "value": "Clean up the verified workspace?"
          }
        }
      }
    },
    "recovery.deferred": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa quét: ổ ngủ hoặc thông tin hiện tại chưa đủ. Có thể yêu cầu quét lại khi ổ sẵn sàng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspection deferred: the drive is asleep or current information is unavailable. Request another scan when it is ready."
          }
        }
      }
    },
