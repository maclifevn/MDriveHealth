    "APFS dùng chung dung lượng với các volume khác trong container. Giữ các volume đó nhàn rỗi trong lúc kiểm tra.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS dùng chung dung lượng với các volume khác trong container. Giữ các volume đó nhàn rỗi trong lúc kiểm tra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS shares capacity with other volumes in its container. Keep those volumes idle during the test."
          }
        }
      }
    },
