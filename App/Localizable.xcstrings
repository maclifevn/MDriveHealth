    "risk.unknown.message": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số SMART hiện có chưa đủ để đánh giá. Duy trì sao lưu và kiểm tra các chỉ báo đã xác định."
