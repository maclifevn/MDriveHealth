        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu firmware không còn chạy nhưng nhật ký không có kết quả mới, có thể đóng lần theo dõi với kết quả chưa xác định."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If firmware is no longer running a test but the log has no new result, you can close tracking with an indeterminate outcome."
          }
        }
      }
    },
    "selftest.commandUnconfirmed": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác nhận firmware đã nhận lệnh. App đang kiểm tra nhật ký và không tự gửi lại lệnh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware acceptance is unconfirmed. The app checks the log and does not automatically resend the command."
          }
        }
      }
    },
    "selftest.error": {
      "localizations": {
