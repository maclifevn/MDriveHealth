    "Ổ chưa trả lời. Đã yêu cầu hủy; chờ ứng dụng dọn xong dữ liệu thử trước khi thao tác tiếp.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ chưa trả lời. Đã yêu cầu hủy; chờ ứng dụng dọn xong dữ liệu thử trước khi thao tác tiếp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device has not responded. Cancellation was requested; wait for the test data to be cleaned up before continuing."
          }
        }
      }
    },
    "Ổ khai khống có thể ghi vòng và làm hỏng dữ liệu sẵn có. Chỉ kiểm tra volume đã sao lưu; ưu tiên ổ ngoài trống có thể xóa bỏ.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ khai khống có thể ghi vòng và làm hỏng dữ liệu sẵn có. Chỉ kiểm tra volume đã sao lưu; ưu tiên ổ ngoài trống có thể xóa bỏ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraudulent firmware may wrap writes and corrupt existing data. Test only backed-up volumes, preferably empty disposable external drives."
          }
        }
      }
    },
    "Ổ ngoài / khác": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ ngoài / khác"
          }
