          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-test capability is unverified. Refresh before starting a test."
          }
        }
      }
    },
    "selftest.capability.unsupported": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
