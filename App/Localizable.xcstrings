          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MDriveHealth currently cannot send Device Self-test commands to NVMe drives through its macOS interface. Overview shows the SMART metrics available; these do not guarantee detection of every drive failure."
          }
