    "share.footer.qd": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo bằng MDriveHealth (QD%1$lld, %2$@) — app sức khoẻ ổ đĩa miễn phí cho cộng đồng Maclife 🇻🇳"
