        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử SMART cần các lần đọc SMART thành công. Ứng dụng chưa đọc được SMART qua giao diện hiện tại; bật theo dõi nền chưa thể tạo lịch sử SMART cho ổ này."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SMART history requires successful SMART reads. The app cannot read SMART through the current interface; enabling background monitoring cannot currently collect SMART history for this drive."
