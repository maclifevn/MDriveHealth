{
  "sourceLanguage": "vi",
  "strings": {
    "%1$lld lỗi I/O liên quan tới %2$@ trong kernel log 24 giờ qua — dấu hiệu cần chú ý ngay cả khi SMART chưa báo.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lỗi I/O liên quan tới %2$@ trong kernel log 24 giờ qua — dấu hiệu cần chú ý ngay cả khi SMART chưa báo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld I/O errors involving %2$@ in the last 24h of kernel logs — worth attention even before SMART flags it."
          }
        }
      }
    },
