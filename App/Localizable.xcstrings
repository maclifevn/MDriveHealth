    "risk.temperature.message": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đang hơi nóng. Nhiệt cao kéo dài có thể làm giảm tuổi thọ và tăng lỗi đọc/ghi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drive is running warm. Sustained heat can shorten lifespan and increase read/write errors."
          }
        }
      }
    },
    "risk.temperature.title": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
